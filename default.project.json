{
  "name": "my-game",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "roblox_packages"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": { "Enum": 4 },
        "ClockTime": 14.5,
        "GeographicLatitude": 25,
        "Brightness": 2,
        "ExposureCompensation": 0,
        "Ambient": { "Color3": [0.1, 0.11, 0.09] },
        "OutdoorAmbient": { "Color3": [0.42, 0.42, 0.36] },
        "ColorShift_Top": { "Color3": [1, 0.92, 0.78] },
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Enabled": true,
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.3
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Enabled": true,
          "Brightness": 0,
          "Contrast": 0.12,
          "Saturation": 0.15,
          "TintColor": { "Color3": [1, 0.98, 0.94] }
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Enabled": false
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.2,
          "Offset": 0.1,
          "Color": { "Color3": [0.72, 0.82, 0.9] },
          "Decay": { "Color3": [0.42, 0.55, 0.62] },
          "Glare": 0,
          "Haze": 1.2
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "SignalBehavior": "Deferred"
      },
      "$path": "src/Workspace",
      "$ignoreUnknownInstances": true
    }
  }
}
