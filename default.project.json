{
  "name": "my-game",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Packages": {
        "$path": "roblox_packages"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": { "Enum": 4 },
        "ClockTime": 14.5,
        "GeographicLatitude": 25,
        "Brightness": 2,
        "ExposureCompensation": 0,
        "Ambient": { "Color3": [0.09, 0.06, 0.14] },
        "OutdoorAmbient": { "Color3": [0.34, 0.26, 0.44] },
        "ColorShift_Top": { "Color3": [0.78, 0.68, 1] },
        "EnvironmentDiffuseScale": 0.4,
        "EnvironmentSpecularScale": 0,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Enabled": true,
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.3
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Enabled": true,
          "Brightness": 0,
          "Contrast": 0.12,
          "Saturation": 0.15,
          "TintColor": { "Color3": [0.98, 0.95, 1] }
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Enabled": false
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.2,
          "Offset": 0.1,
          "Color": { "Color3": [0.55, 0.4, 0.75] },
          "Decay": { "Color3": [0.3, 0.15, 0.45] },
          "Glare": 0,
          "Haze": 1.2
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "SignalBehavior": "Deferred"
      },
      "$path": "src/Workspace",
      "$ignoreUnknownInstances": true
    }
  }
}
